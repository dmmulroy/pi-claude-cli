{
  "name": "@saccolabs/pi-claude-cli",
  "version": "0.12.0",
  "private": true,
  "description": "Pi coding agent extension that routes LLM calls through the Claude Code CLI",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmmulroy/pi-claude-cli"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ready": "vp check && vp test run && vp run test:scenarios && vp run test:e2e",
    "test:coverage": "vp test --coverage",
    "test:e2e": "bash scripts/e2e-stub.sh",
    "test:scenarios": "node scripts/scenarios.ts",
    "trace": "node scripts/trace.ts"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.3",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.14.0",
  "pi": {
    "extensions": [
      "index.ts"
    ]
  }
}
